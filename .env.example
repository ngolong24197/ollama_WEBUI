# Ollama Chat UI Configuration

# Ollama API URL (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# SearXNG URL (default: http://localhost:8080)
SEARXNG_URL=http://localhost:8080

# Database URL (default: sqlite+aiosqlite:///data/chat.db)
DATABASE_URL=sqlite+aiosqlite:///data/chat.db

# Max image upload size in MB (default: 10)
MAX_IMAGE_SIZE_MB=10

# Stream timeout in seconds (default: 300)
STREAM_TIMEOUT_SECONDS=300

# Debug mode (default: false)
DEBUG=false